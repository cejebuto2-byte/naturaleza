<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <a href="/aportes" class="text-blue-600 hover:text-blue-800 text-sm font-medium mb-2 inline-block">
      ← Volver a Aportes
    </a>
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Ofrecer Voluntariado</h1>
    <p class="text-gray-600">Dona tu tiempo y conocimientos para apoyar a comunidades afectadas</p>
  </div>

  <!-- Información -->
  <div class="bg-orange-50 border-l-4 border-orange-500 p-6 rounded-lg mb-8">
    <div class="flex">
      <svg class="w-6 h-6 text-orange-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
      <div>
        <h3 class="text-lg font-semibold text-orange-900 mb-2">Actividades de voluntariado disponibles</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-orange-800 text-sm">
          <div>
            <p class="font-semibold">• Apoyo Psicosocial</p>
            <p class="text-xs pl-4">Atención a familias y comunidades afectadas</p>
          </div>
          <div>
            <p class="font-semibold">• Talleres Educativos</p>
            <p class="text-xs pl-4">Clases de refuerzo, alfabetización, oficios</p>
          </div>
          <div>
            <p class="font-semibold">• Actividades Recreativas</p>
            <p class="text-xs pl-4">Juegos, deportes, arte para niños</p>
          </div>
          <div>
            <p class="font-semibold">• Brigadas de Salud</p>
            <p class="text-xs pl-4">Atención médica, jornadas de vacunación</p>
          </div>
          <div>
            <p class="font-semibold">• Talleres de Resiliencia</p>
            <p class="text-xs pl-4">Fortalecimiento comunitario, autocuidado</p>
          </div>
          <div>
            <p class="font-semibold">• Apoyo Logístico</p>
            <p class="text-xs pl-4">Organización de entregas, inventarios</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulario -->
  <div class="bg-white rounded-lg shadow-md p-8 max-w-2xl mx-auto">
    <form action="/aportes/voluntariado" method="POST">
      <!-- Información Personal -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Información Personal</h2>

        <div class="mb-4">
          <label for="nombre" class="block text-sm font-medium text-gray-700 mb-2">
            Nombre Completo *
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Ej: Jorge Morales"
          />
        </div>

        <div class="mb-4">
          <label for="cargo" class="block text-sm font-medium text-gray-700 mb-2">
            Cargo / Profesión *
          </label>
          <input
            type="text"
            id="cargo"
            name="cargo"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Ej: Psicólogo / Trabajadora Social / Educador"
          />
        </div>
      </div>

      <!-- Detalles del Voluntariado -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Detalles del Voluntariado</h2>

        <div class="mb-4">
          <label for="actividad" class="block text-sm font-medium text-gray-700 mb-2">
            Actividad a Realizar *
          </label>
          <select
            id="actividad"
            name="actividad"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
          >
            <option value="">Selecciona una actividad</option>
            <option value="Talleres de resiliencia comunitaria">Talleres de resiliencia comunitaria</option>
            <option value="Atención psicosocial a familias">Atención psicosocial a familias</option>
            <option value="Clases de refuerzo educativo">Clases de refuerzo educativo</option>
            <option value="Actividades recreativas para niños">Actividades recreativas para niños</option>
            <option value="Brigada de salud">Brigada de salud</option>
            <option value="Apoyo logístico">Apoyo logístico</option>
            <option value="Capacitación en oficios">Capacitación en oficios</option>
            <option value="Talleres de derechos humanos">Talleres de derechos humanos</option>
            <option value="Otra">Otra actividad</option>
          </select>
        </div>

        <div class="mb-4" id="otraActividadDiv" style="display: none;">
          <label for="otraActividad" class="block text-sm font-medium text-gray-700 mb-2">
            Especifica la actividad
          </label>
          <input
            type="text"
            id="otraActividad"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Describe la actividad que deseas realizar"
          />
        </div>

        <div class="mb-4">
          <label for="horas" class="block text-sm font-medium text-gray-700 mb-2">
            Horas Disponibles *
          </label>
          <input
            type="number"
            id="horas"
            name="horas"
            min="1"
            max="200"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Ej: 20"
          />
          <p class="text-xs text-gray-500 mt-1">Número de horas que puedes dedicar a esta actividad</p>
        </div>

        <div class="mb-4">
          <label for="fecha" class="block text-sm font-medium text-gray-700 mb-2">
            Fecha Disponible *
          </label>
          <input
            type="date"
            id="fecha"
            name="fecha"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
          />
          <p class="text-xs text-gray-500 mt-1">Fecha en que estarías disponible para iniciar</p>
        </div>

        <div class="mb-4">
          <label for="lugar" class="block text-sm font-medium text-gray-700 mb-2">
            Región / Lugar Preferido *
          </label>
          <input
            type="text"
            id="lugar"
            name="lugar"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Ej: Nariño - Tumaco"
          />
          <p class="text-xs text-gray-500 mt-1">Departamento o región donde te gustaría realizar el voluntariado</p>
        </div>
      </div>

      <!-- Habilidades y experiencia -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Experiencia y Habilidades (Opcional)</h2>

        <div class="mb-4">
          <label for="experiencia" class="block text-sm font-medium text-gray-700 mb-2">
            Experiencia Previa
          </label>
          <textarea
            id="experiencia"
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Describe tu experiencia relevante en actividades similares"
          ></textarea>
        </div>

        <div class="mb-4">
          <label for="habilidades" class="block text-sm font-medium text-gray-700 mb-2">
            Habilidades Especiales
          </label>
          <textarea
            id="habilidades"
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            placeholder="Ej: Manejo de primeros auxilios, idiomas, instrumentos musicales, etc."
          ></textarea>
        </div>
      </div>

      <!-- Información adicional -->
      <div class="bg-gray-50 rounded-lg p-6 mb-6">
        <h3 class="font-semibold text-gray-900 mb-3">Proceso de voluntariado</h3>
        <ol class="text-sm text-gray-700 space-y-2">
          <li class="flex items-start">
            <span class="bg-orange-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs mr-3 flex-shrink-0 mt-0.5">1</span>
            <span>Recibirás confirmación de tu registro y validación de tu perfil</span>
          </li>
          <li class="flex items-start">
            <span class="bg-orange-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs mr-3 flex-shrink-0 mt-0.5">2</span>
            <span>Te contactaremos para coordinar detalles logísticos y necesidades específicas</span>
          </li>
          <li class="flex items-start">
            <span class="bg-orange-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs mr-3 flex-shrink-0 mt-0.5">3</span>
            <span>Recibirás inducción sobre la comunidad y el contexto de la zona</span>
          </li>
          <li class="flex items-start">
            <span class="bg-orange-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs mr-3 flex-shrink-0 mt-0.5">4</span>
            <span>Al finalizar, recibirás certificado de voluntariado con las horas realizadas</span>
          </li>
        </ol>
      </div>

      <!-- Términos -->
      <div class="mb-6 space-y-3">
        <label class="flex items-start">
          <input type="checkbox" required class="mt-1 mr-3">
          <span class="text-sm text-gray-700">
            Me comprometo a cumplir con las horas y actividades acordadas de manera responsable.
          </span>
        </label>
        <label class="flex items-start">
          <input type="checkbox" required class="mt-1 mr-3">
          <span class="text-sm text-gray-700">
            Entiendo que trabajaré con comunidades en situación de vulnerabilidad y me comprometo a actuar con respeto, empatía y profesionalismo.
          </span>
        </label>
      </div>

      <!-- Botones -->
      <div class="flex flex-col sm:flex-row gap-4">
        <button
          type="submit"
          class="flex-1 bg-orange-600 hover:bg-orange-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors duration-200"
        >
          Registrar Voluntariado
        </button>
        <a
          href="/aportes"
          class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-semibold text-center transition-colors duration-200"
        >
          Cancelar
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  // Mostrar campo "Otra actividad" si se selecciona
  document.getElementById('actividad')?.addEventListener('change', function(e) {
    const otraDiv = document.getElementById('otraActividadDiv');
    const otraInput = document.getElementById('otraActividad');
    if (e.target.value === 'Otra') {
      otraDiv.style.display = 'block';
      otraInput.required = true;
    } else {
      otraDiv.style.display = 'none';
      otraInput.required = false;
    }
  });

  // Usar valor de "Otra actividad" si está especificado
  document.querySelector('form')?.addEventListener('submit', function(e) {
    const actividadSelect = document.getElementById('actividad');
    const otraInput = document.getElementById('otraActividad');
    if (actividadSelect.value === 'Otra' && otraInput.value) {
      // Crear un input hidden con el valor de "otra actividad"
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'actividad';
      hiddenInput.value = otraInput.value;
      this.appendChild(hiddenInput);
      // Deshabilitar el select para que no se envíe
      actividadSelect.disabled = true;
    }
  });

  // Establecer fecha mínima de hoy
  const fechaInput = document.getElementById('fecha');
  if (fechaInput) {
    const hoy = new Date().toISOString().split('T')[0];
    fechaInput.setAttribute('min', hoy);
    fechaInput.value = hoy;
  }
</script>
