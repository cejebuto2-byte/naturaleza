<style>
  body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
  .kids-card {
    transform: rotate(-1deg);
    transition: all 0.3s ease;
  }
  .kids-card:hover {
    transform: rotate(0deg) scale(1.05);
  }
  .kids-card:nth-child(even) {
    transform: rotate(1deg);
  }
  .kids-card:nth-child(even):hover {
    transform: rotate(0deg) scale(1.05);
  }
</style>

<div class="min-h-screen py-8">
  <div class="container mx-auto px-4">
    <!-- Header colorido -->
    <div class="text-center mb-12">
      <h1 class="text-6xl font-black text-white mb-4 animate-bounce">
        🌈 LA NATURALEZA KIDS 🌈
      </h1>
      <p class="text-2xl text-white font-semibold">
        ¡Aprende, juega y diviértete ayudando a tu comunidad!
      </p>
    </div>

    <!-- Barra de progreso del usuario -->
    <div class="bg-white rounded-3xl shadow-2xl p-6 mb-8 mx-auto max-w-4xl">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-4">
          <div class="w-16 h-16 bg-gradient-to-br from-pink-400 to-purple-500 rounded-full flex items-center justify-center text-3xl">
            😊
          </div>
          <div>
            <h2 class="text-2xl font-bold text-gray-800">¡Hola, {{usuario}}!</h2>
            <p class="text-gray-600">Nivel {{progreso.nivel}} - {{formatNumber progreso.puntos}} puntos</p>
          </div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-black text-purple-600">⭐</div>
          <p class="text-sm text-gray-600">{{progreso.insignias.length}} insignias</p>
        </div>
      </div>

      <!-- Barra de progreso -->
      <div class="w-full bg-gray-200 rounded-full h-6 overflow-hidden">
        <div
          class="h-6 bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 rounded-full flex items-center justify-center text-white text-xs font-bold"
          style="width: {{#if (eq progreso.nivel 10)}}100{{else}}{{progreso.puntos}}{{/if}}%"
        >
          {{progreso.puntos}} pts
        </div>
      </div>

      <!-- Insignias -->
      {{#if progreso.insignias}}
      <div class="mt-4 flex flex-wrap gap-2">
        <p class="w-full text-sm font-semibold text-gray-700">Tus insignias:</p>
        {{#each progreso.insignias}}
        <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-semibold">
          🏆 {{this}}
        </span>
        {{/each}}
      </div>
      {{/if}}
    </div>

    <!-- Secciones principales -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
      <!-- Aprende -->
      <a href="/kids/aprende?usuario={{usuario}}" class="kids-card">
        <div class="bg-gradient-to-br from-blue-400 to-blue-600 rounded-3xl shadow-2xl p-8 text-center text-white hover:shadow-3xl">
          <div class="text-7xl mb-4">📚</div>
          <h3 class="text-3xl font-black mb-2">Aprende</h3>
          <p class="text-lg">Descubre cosas nuevas</p>
        </div>
      </a>

      <!-- Juega -->
      <a href="/kids/juega?usuario={{usuario}}" class="kids-card">
        <div class="bg-gradient-to-br from-green-400 to-green-600 rounded-3xl shadow-2xl p-8 text-center text-white hover:shadow-3xl">
          <div class="text-7xl mb-4">🎮</div>
          <h3 class="text-3xl font-black mb-2">Juega</h3>
          <p class="text-lg">Diviértete aprendiendo</p>
        </div>
      </a>

      <!-- Cuentos -->
      <a href="/kids/cuentos?usuario={{usuario}}" class="kids-card">
        <div class="bg-gradient-to-br from-pink-400 to-pink-600 rounded-3xl shadow-2xl p-8 text-center text-white hover:shadow-3xl">
          <div class="text-7xl mb-4">📖</div>
          <h3 class="text-3xl font-black mb-2">Cuentos</h3>
          <p class="text-lg">Lee historias mágicas</p>
        </div>
      </a>

      <!-- Crea -->
      <div class="kids-card cursor-not-allowed opacity-75">
        <div class="bg-gradient-to-br from-orange-400 to-orange-600 rounded-3xl shadow-2xl p-8 text-center text-white">
          <div class="text-7xl mb-4">🎨</div>
          <h3 class="text-3xl font-black mb-2">Crea</h3>
          <p class="text-lg">Próximamente</p>
        </div>
      </div>
    </div>

    <!-- Actividades recientes -->
    <div class="bg-white rounded-3xl shadow-2xl p-8 mt-12 max-w-4xl mx-auto">
      <h2 class="text-3xl font-black text-gray-800 mb-6 text-center">📊 Tu Progreso</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center p-6 bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl">
          <div class="text-5xl mb-2">📚</div>
          <div class="text-3xl font-black text-blue-800">{{progreso.cuentosLeidos.length}}</div>
          <p class="text-blue-700 font-semibold">Cuentos Leídos</p>
        </div>
        <div class="text-center p-6 bg-gradient-to-br from-green-100 to-green-200 rounded-2xl">
          <div class="text-5xl mb-2">🎮</div>
          <div class="text-3xl font-black text-green-800">{{progreso.juegosCompletados.length}}</div>
          <p class="text-green-700 font-semibold">Juegos Completados</p>
        </div>
        <div class="text-center p-6 bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl">
          <div class="text-5xl mb-2">⭐</div>
          <div class="text-3xl font-black text-purple-800">{{progreso.actividadesRealizadas}}</div>
          <p class="text-purple-700 font-semibold">Actividades</p>
        </div>
      </div>
    </div>

    <!-- Mensaje motivacional -->
    <div class="text-center mt-12">
      <div class="bg-white rounded-3xl shadow-2xl p-8 max-w-2xl mx-auto">
        <p class="text-2xl font-bold text-gray-800 mb-4">
          💪 ¡Sigue adelante, campeón!
        </p>
        <p class="text-lg text-gray-600">
          Cada actividad que completas te acerca más a convertirte en un
          <span class="text-green-600 font-bold">Guardián de la Naturaleza</span>
        </p>
      </div>
    </div>
  </div>
</div>
