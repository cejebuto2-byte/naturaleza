<!-- Incluir Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Seguimiento en Tiempo Real</h1>
    <p class="text-gray-600">Métricas, análisis y reportes de impacto</p>
  </div>

  <!-- Indicadores Principales -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold opacity-90">Total Aportes</h3>
        <svg class="w-8 h-8 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-3xl font-bold">{{formatCurrency resumenImpacto.montoTotal}}</p>
      <p class="text-xs opacity-80 mt-1">{{resumenImpacto.totalAportes}} contribuciones</p>
    </div>

    <div class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold opacity-90">Beneficiados</h3>
        <svg class="w-8 h-8 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
      </div>
      <p class="text-3xl font-bold">{{formatNumber resumenImpacto.totalBeneficiados}}</p>
      <p class="text-xs opacity-80 mt-1">personas</p>
    </div>

    <div class="bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold opacity-90">Intervenciones</h3>
        <svg class="w-8 h-8 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-3xl font-bold">{{resumenImpacto.intervencionesCompletadas}}</p>
      <p class="text-xs opacity-80 mt-1">completadas</p>
    </div>

    <div class="bg-gradient-to-br from-orange-500 to-orange-600 text-white rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold opacity-90">Eficiencia</h3>
        <svg class="w-8 h-8 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
        </svg>
      </div>
      <p class="text-3xl font-bold">{{resumenImpacto.eficienciaEntrega}}</p>
      <p class="text-xs opacity-80 mt-1">de entrega</p>
    </div>
  </div>

  <!-- Botones de Exportación -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Exportar Reportes</h2>
        <p class="text-sm text-gray-600">Descarga reportes completos con todas las métricas</p>
      </div>
      <div class="flex gap-4 mt-4 md:mt-0">
        <a href="/seguimiento/reporte/pdf" target="_blank" class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          <span>Exportar PDF</span>
        </a>
        <a href="/seguimiento/reporte/excel" target="_blank" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>Exportar Excel</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Gráficos -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Gráfico de Evolución Temporal -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Evolución Temporal</h2>
      <canvas id="graficoEvolucion" height="250"></canvas>
    </div>

    <!-- Gráfico de Distribución de Recursos -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Distribución de Recursos</h2>
      <canvas id="graficoDistribucion" height="250"></canvas>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Gráfico de Aportes por Mes -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Aportes por Mes</h2>
      <canvas id="graficoAportes" height="250"></canvas>
    </div>

    <!-- Gráfico de Zonas por Región -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Intervenciones por Departamento</h2>
      <canvas id="graficoRegiones" height="250"></canvas>
    </div>
  </div>

  <!-- Línea de Tiempo -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-6">Línea de Tiempo de Intervenciones</h2>

    <div class="relative">
      <!-- Línea vertical -->
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-200"></div>

      <div class="space-y-8">
        {{#each lineaTiempo}}
        <div class="relative pl-20">
          <!-- Punto en la línea -->
          <div class="absolute left-6 top-0 w-4 h-4 rounded-full {{#if (eq estado 'completado')}}bg-green-500{{else}}bg-blue-500{{/if}} border-4 border-white shadow"></div>

          <!-- Card de intervención -->
          <div class="bg-gray-50 rounded-lg p-4 hover:shadow-md transition-shadow {{#if (eq estado 'completado')}}border-l-4 border-green-500{{else}}border-l-4 border-blue-500{{/if}}">
            <div class="flex justify-between items-start mb-2">
              <div>
                <span class="text-xs px-2 py-1 rounded-full font-semibold {{#if (eq estado 'completado')}}bg-green-100 text-green-800{{else}}bg-blue-100 text-blue-800{{/if}}">
                  {{tipo}}
                </span>
                <span class="text-xs text-gray-500 ml-2">{{formatDateShort fecha}}</span>
              </div>
              <span class="text-xs px-2 py-1 rounded-full font-semibold {{#if (eq estado 'completado')}}bg-green-100 text-green-800{{else}}bg-blue-100 text-blue-800{{/if}}">
                {{#if (eq estado 'completado')}}✓ Completado{{else}}⏱ Programado{{/if}}
              </span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">{{titulo}}</h3>
            <p class="text-sm text-gray-600 mb-2">{{descripcion}}</p>
            <div class="flex items-center justify-between text-xs text-gray-500">
              <span>📍 {{zona}}</span>
              <span>👥 {{formatNumber beneficiados}} beneficiados</span>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>

<script>
  // Configuración común para todos los gráficos
  Chart.defaults.font.family = 'Arial, sans-serif';
  Chart.defaults.color = '#374151';

  // Gráfico de Evolución Temporal (Líneas)
  fetch('/seguimiento/api/grafico-evolucion')
    .then(res => res.json())
    .then(data => {
      const ctx = document.getElementById('graficoEvolucion').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: data,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'bottom',
            },
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return value.toLocaleString('es-CO');
                }
              }
            }
          }
        }
      });
    });

  // Gráfico de Distribución de Recursos (Pie/Doughnut)
  fetch('/seguimiento/api/grafico-distribucion')
    .then(res => res.json())
    .then(data => {
      const ctx = document.getElementById('graficoDistribucion').getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: data,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'bottom',
            },
          }
        }
      });
    });

  // Gráfico de Aportes por Mes (Barras)
  fetch('/seguimiento/api/grafico-aportes')
    .then(res => res.json())
    .then(data => {
      const ctx = document.getElementById('graficoAportes').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: data.labels,
          datasets: [{
            label: 'Aportes (COP)',
            data: data.valores,
            backgroundColor: 'rgba(59, 130, 246, 0.6)',
            borderColor: '#3b82f6',
            borderWidth: 2,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false,
            },
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return '$' + value.toLocaleString('es-CO');
                }
              }
            }
          }
        }
      });
    });

  // Gráfico de Regiones (Barras horizontales)
  fetch('/seguimiento/api/grafico-regiones')
    .then(res => res.json())
    .then(data => {
      const ctx = document.getElementById('graficoRegiones').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: data,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          plugins: {
            legend: {
              display: false,
            },
          },
          scales: {
            x: {
              beginAtZero: true,
            }
          }
        }
      });
    });
</script>
