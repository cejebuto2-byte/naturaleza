  .maplibregl-popup-content {
    padding: 0;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(16, 185, 129, 0.3);
  }
  .maplibregl-popup-tip {
    border-top-color: white;
  }
</style>
