<!-- Script del Mapa -->
<script src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>
<link href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" rel="stylesheet" />

<script>
  // Inicializar mapa cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', function() {
    const map = new maplibregl.Map({
      container: 'map',
      style: {
        version: 8,
        sources: {
          'osm': {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '© OpenStreetMap contributors'
          }
        },
        layers: [{
          id: 'osm',
          type: 'raster',
          source: 'osm',
          minzoom: 0,
          maxzoom: 19
        }]
      },
      center: [-74.1, 4.65],
      zoom: 5,
      maxZoom: 10,
      minZoom: 4
    });

    // Agregar controles de navegación
    map.addControl(new maplibregl.NavigationControl(), 'top-right');

    map.on('load', () => {
      // Cargar GeoJSON de departamentos de Colombia
      map.addSource('departamentos', {
        type: 'geojson',
        data: 'https://gist.githubusercontent.com/john-guerra/43c7656821069d00dcbc/raw/3aadedf47badbdac823b00dbe259f6bc6d9e1899/colombia.geo.json'
      });

      // Capa de relleno para departamentos
      map.addLayer({
        id: 'departamentos-fill',
        type: 'fill',
        source: 'departamentos',
        paint: {
          'fill-color': [
            'interpolate',
            ['linear'],
            ['get', 'AREA'],
            0, '#d1fae5',
            50000, '#6ee7b7',
            100000, '#34d399',
            150000, '#10b981',
            200000, '#059669'
          ],
          'fill-opacity': 0.6
        }
      });

      // Capa de borde
      map.addLayer({
        id: 'departamentos-border',
        type: 'line',
        source: 'departamentos',
        paint: {
          'line-color': '#059669',
          'line-width': 2,
          'line-opacity': 0.8
        }
      });

      // Popup para hover
      const popup = new maplibregl.Popup({
        closeButton: false,
        closeOnClick: false
      });

      map.on('mouseenter', 'departamentos-fill', (e) => {
        map.getCanvas().style.cursor = 'pointer';
        const feature = e.features[0];
        const departamento = feature.properties.NOMBRE_DPT || feature.properties.name || 'Departamento';

        popup
          .setLngLat(e.lngLat)
          .setHTML(`
            <div class="p-3 font-semibold text-green-900">
              ${departamento}
            </div>
          `)
          .addTo(map);
      });

      map.on('mouseleave', 'departamentos-fill', () => {
        map.getCanvas().style.cursor = '';
        popup.remove();
      });

      // Click para más info
      map.on('click', 'departamentos-fill', (e) => {
        const feature = e.features[0];
        const departamento = feature.properties.NOMBRE_DPT || feature.properties.name || 'Departamento';

        new maplibregl.Popup()
          .setLngLat(e.lngLat)
          .setHTML(`
            <div class="p-4 min-w-[200px]">
              <h3 class="font-bold text-lg text-green-900 mb-3">${departamento}</h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between border-b border-gray-200 pb-2">
                  <span class="text-gray-600">Aportes recibidos:</span>
                  <span class="font-semibold text-green-700">${Math.floor(Math.random() * 50) + 10}</span>
                </div>
                <div class="flex justify-between border-b border-gray-200 pb-2">
                  <span class="text-gray-600">Personas beneficiadas:</span>
                  <span class="font-semibold text-green-700">${Math.floor(Math.random() * 500) + 100}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Zonas atendidas:</span>
                  <span class="font-semibold text-green-700">${Math.floor(Math.random() * 10) + 1}</span>
                </div>
              </div>
              <a href="/mapa" class="mt-4 block text-center px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg text-sm font-medium hover:shadow-lg transition-all">
                Ver en Mapa Completo
              </a>
            </div>
          `)
          .addTo(map);
      });
    });
  });
</script>

