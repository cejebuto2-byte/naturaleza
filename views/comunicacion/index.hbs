<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-800 mb-2">Comunicación Comunitaria</h1>
    <p class="text-gray-600">Reportes y necesidades de líderes comunitarios y defensores regionales</p>
  </div>

  <!-- Mensaje de éxito -->
  {{#if mensajeExito}}
  <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-6 shadow">
    <div class="flex items-center">
      <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <p class="font-semibold">{{mensajeExito}}</p>
    </div>
  </div>
  {{/if}}

  <!-- Estadísticas -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Total Reportes</p>
          <p class="text-3xl font-bold text-gray-800 mt-1">{{formatNumber estadisticas.totalReportes}}</p>
        </div>
        <div class="bg-blue-100 rounded-full p-3">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Personas Afectadas</p>
          <p class="text-3xl font-bold text-gray-800 mt-1">{{formatNumber estadisticas.personasAfectadasTotal}}</p>
        </div>
        <div class="bg-orange-100 rounded-full p-3">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Urgentes</p>
          <p class="text-3xl font-bold text-red-600 mt-1">{{estadisticas.reportesPorUrgencia.critica}}</p>
        </div>
        <div class="bg-red-100 rounded-full p-3">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Resueltos</p>
          <p class="text-3xl font-bold text-green-600 mt-1">{{estadisticas.reportesPorEstado.resuelto}}</p>
        </div>
        <div class="bg-green-100 rounded-full p-3">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Filtrar Reportes</h3>
    <form action="/comunicacion" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Estado</label>
        <select name="estado" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          <option value="">Todos</option>
          <option value="nuevo" {{#if (eq filtros.estado 'nuevo')}}selected{{/if}}>Nuevo</option>
          <option value="en_revision" {{#if (eq filtros.estado 'en_revision')}}selected{{/if}}>En Revisión</option>
          <option value="en_atencion" {{#if (eq filtros.estado 'en_atencion')}}selected{{/if}}>En Atención</option>
          <option value="resuelto" {{#if (eq filtros.estado 'resuelto')}}selected{{/if}}>Resuelto</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Urgencia</label>
        <select name="urgencia" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          <option value="">Todas</option>
          <option value="critica" {{#if (eq filtros.urgencia 'critica')}}selected{{/if}}>Crítica</option>
          <option value="alta" {{#if (eq filtros.urgencia 'alta')}}selected{{/if}}>Alta</option>
          <option value="media" {{#if (eq filtros.urgencia 'media')}}selected{{/if}}>Media</option>
          <option value="baja" {{#if (eq filtros.urgencia 'baja')}}selected{{/if}}>Baja</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Necesidad</label>
        <select name="tipo" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          <option value="">Todos</option>
          {{#each tiposNecesidad}}
          <option value="{{this}}" {{#if (eq this ../filtros.tipo)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Región</label>
        <select name="region" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          <option value="">Todas</option>
          {{#each regiones}}
          <option value="{{this}}" {{#if (eq this ../filtros.region)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>

      <div class="md:col-span-4 flex gap-2">
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
          Aplicar Filtros
        </button>
        <a href="/comunicacion" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
          Limpiar
        </a>
      </div>
    </form>
  </div>

  <!-- Grid de reportes -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    {{#each reportes}}
    <a href="/comunicacion/reporte/{{this.id}}" class="bg-white rounded-lg shadow-md hover:shadow-xl transition p-6 block">
      <!-- Header con badges -->
      <div class="flex justify-between items-start mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold
          {{#if (eq this.estado 'nuevo')}}bg-blue-100 text-blue-800{{/if}}
          {{#if (eq this.estado 'en_revision')}}bg-yellow-100 text-yellow-800{{/if}}
          {{#if (eq this.estado 'en_atencion')}}bg-orange-100 text-orange-800{{/if}}
          {{#if (eq this.estado 'resuelto')}}bg-green-100 text-green-800{{/if}}
        ">
          {{#if (eq this.estado 'nuevo')}}Nuevo{{/if}}
          {{#if (eq this.estado 'en_revision')}}En Revisión{{/if}}
          {{#if (eq this.estado 'en_atencion')}}En Atención{{/if}}
          {{#if (eq this.estado 'resuelto')}}Resuelto{{/if}}
        </span>

        <span class="px-3 py-1 rounded-full text-xs font-semibold
          {{#if (eq this.nivelUrgencia 'critica')}}bg-red-500 text-white{{/if}}
          {{#if (eq this.nivelUrgencia 'alta')}}bg-orange-500 text-white{{/if}}
          {{#if (eq this.nivelUrgencia 'media')}}bg-yellow-400 text-gray-900{{/if}}
          {{#if (eq this.nivelUrgencia 'baja')}}bg-green-500 text-white{{/if}}
        ">
          {{#if (eq this.nivelUrgencia 'critica')}}Crítica{{/if}}
          {{#if (eq this.nivelUrgencia 'alta')}}Alta{{/if}}
          {{#if (eq this.nivelUrgencia 'media')}}Media{{/if}}
          {{#if (eq this.nivelUrgencia 'baja')}}Baja{{/if}}
        </span>
      </div>

      <!-- Tipo de necesidad -->
      <div class="mb-3">
        <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 rounded text-sm font-medium">
          {{this.tipoNecesidad}}
        </span>
      </div>

      <!-- Ubicación -->
      <h3 class="text-lg font-bold text-gray-800 mb-2">{{this.municipio}}, {{this.departamento}}</h3>
      <p class="text-sm text-gray-600 mb-3">{{this.region}}</p>

      <!-- Descripción -->
      <p class="text-gray-700 mb-4 line-clamp-3">{{this.descripcion}}</p>

      <!-- Información del reportante -->
      <div class="border-t pt-4">
        <p class="text-sm text-gray-600 mb-1"><strong>Reportante:</strong> {{this.nombreReportante}}</p>
        <p class="text-sm text-gray-600 mb-1"><strong>Cargo:</strong> {{this.cargoRol}}</p>
        <p class="text-sm text-gray-600 mb-1"><strong>Fecha:</strong> {{formatDate this.fechaReporte}}</p>
        {{#if this.personasAfectadas}}
        <p class="text-sm text-gray-600"><strong>Personas afectadas:</strong> {{formatNumber this.personasAfectadas}}</p>
        {{/if}}
      </div>

      <!-- Indicador de respuestas -->
      {{#if this.respuestas.length}}
      <div class="mt-4 flex items-center text-sm text-blue-600">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        {{this.respuestas.length}} respuesta{{#if (gte this.respuestas.length 2)}}s{{/if}}
      </div>
      {{/if}}
    </a>
    {{/each}}
  </div>

  {{#unless reportes.length}}
  <div class="bg-white rounded-lg shadow-md p-12 text-center">
    <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
    </svg>
    <h3 class="text-xl font-semibold text-gray-700 mb-2">No hay reportes con esos filtros</h3>
    <p class="text-gray-500 mb-4">Intenta ajustar los filtros o crear un nuevo reporte</p>
    <a href="/comunicacion" class="text-blue-600 hover:text-blue-700 font-medium">Ver todos los reportes</a>
  </div>
  {{/unless}}
</div>

<!-- Botón flotante para nuevo reporte -->
<a href="/comunicacion/nuevo" class="fixed bottom-8 right-8 bg-blue-600 text-white rounded-full p-4 shadow-lg hover:bg-blue-700 transition hover:scale-110 transform">
  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
  </svg>
</a>
