<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Header -->
  <div class="mb-8">
    <a href="/alertas" class="text-blue-600 hover:text-blue-700 flex items-center mb-4">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Volver a alertas
    </a>
    <h1 class="text-4xl font-bold text-gray-800 mb-2 flex items-center">
      <svg class="w-10 h-10 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
      </svg>
      Suscribirse a Alertas
    </h1>
    <p class="text-gray-600">Recibe notificaciones personalizadas sobre alertas en tu región</p>
  </div>

  <!-- Mensaje de éxito -->
  {{#if mensajeExito}}
  <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-6 shadow animate-fade-in">
    <div class="flex items-center">
      <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <p class="font-semibold">{{mensajeExito}}</p>
    </div>
  </div>
  {{/if}}

  <!-- Información sobre el servicio -->
  <div class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-8 rounded-lg shadow">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-6 w-6 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-lg font-medium text-blue-800">¿Cómo funciona?</h3>
        <div class="mt-2 text-sm text-blue-700">
          <ul class="list-disc list-inside space-y-1">
            <li>Recibirás notificaciones solo sobre las alertas que selecciones</li>
            <li>Puedes personalizar por tipo de emergencia y nivel de severidad</li>
            <li>Las notificaciones se enviarán a tu email y opcionalmente por SMS</li>
            <li>Puedes actualizar tus preferencias en cualquier momento</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulario de suscripción -->
  <form action="/alertas/suscripcion" method="POST" class="bg-white rounded-lg shadow-md p-8">
    <!-- Información personal -->
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-4 pb-2 border-b">Información Personal</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="nombre" class="block text-sm font-medium text-gray-700 mb-2">
            Nombre Completo <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Ej: María González"
          >
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
            Correo Electrónico <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="correo@ejemplo.com"
          >
        </div>

        <div class="md:col-span-2">
          <label for="telefono" class="block text-sm font-medium text-gray-700 mb-2">
            Teléfono (Opcional)
          </label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Ej: +57 300 123 4567"
          >
          <p class="text-xs text-gray-500 mt-1">Para recibir notificaciones por SMS</p>
        </div>
      </div>
    </div>

    <!-- Ubicación -->
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-4 pb-2 border-b">Ubicación</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="departamento" class="block text-sm font-medium text-gray-700 mb-2">
            Departamento <span class="text-red-500">*</span>
          </label>
          <select
            id="departamento"
            name="departamento"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">Seleccione...</option>
            {{#each departamentos}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>

        <div>
          <label for="municipio" class="block text-sm font-medium text-gray-700 mb-2">
            Municipio <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="municipio"
            name="municipio"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Ej: Cartagena"
          >
        </div>
      </div>
    </div>

    <!-- Tipos de alerta -->
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-4 pb-2 border-b">Tipos de Alerta de Interés</h2>
      <p class="text-sm text-gray-600 mb-4">Selecciona los tipos de emergencias sobre las que deseas recibir notificaciones</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition">
          <input type="checkbox" name="tiposAlerta" value="meteorologica" class="w-5 h-5 text-blue-600">
          <span class="ml-3 text-gray-700">
            <span class="text-lg mr-2">☁️</span>
            <strong>Meteorológica</strong> - Tormentas, huracanes, lluvias intensas
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition">
          <input type="checkbox" name="tiposAlerta" value="sismica" class="w-5 h-5 text-blue-600">
          <span class="ml-3 text-gray-700">
            <span class="text-lg mr-2">🌋</span>
            <strong>Sísmica</strong> - Terremotos, temblores, actividad volcánica
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition">
          <input type="checkbox" name="tiposAlerta" value="inundacion" class="w-5 h-5 text-blue-600">
          <span class="ml-3 text-gray-700">
            <span class="text-lg mr-2">🌊</span>
            <strong>Inundación</strong> - Desbordamientos, crecientes, avalanchas
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition">
          <input type="checkbox" name="tiposAlerta" value="deslizamiento" class="w-5 h-5 text-blue-600">
          <span class="ml-3 text-gray-700">
            <span class="text-lg mr-2">⛰️</span>
            <strong>Deslizamiento</strong> - Derrumbes, movimientos de tierra
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition">
          <input type="checkbox" name="tiposAlerta" value="incendio" class="w-5 h-5 text-blue-600">
          <span class="ml-3 text-gray-700">
            <span class="text-lg mr-2">🔥</span>
            <strong>Incendio</strong> - Incendios forestales, estructurales
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition">
          <input type="checkbox" name="tiposAlerta" value="sequia" class="w-5 h-5 text-blue-600">
          <span class="ml-3 text-gray-700">
            <span class="text-lg mr-2">🏜️</span>
            <strong>Sequía</strong> - Escasez de agua, olas de calor
          </span>
        </label>
      </div>
    </div>

    <!-- Niveles de severidad -->
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-4 pb-2 border-b">Niveles de Severidad de Interés</h2>
      <p class="text-sm text-gray-600 mb-4">Selecciona los niveles de severidad sobre los que deseas ser notificado</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="flex items-center p-4 border-2 border-red-200 rounded-lg cursor-pointer hover:bg-red-50 hover:border-red-400 transition">
          <input type="checkbox" name="nivelesInteres" value="rojo" class="w-5 h-5 text-red-600">
          <span class="ml-3">
            <span class="text-lg mr-2">🔴</span>
            <strong class="text-red-700">Nivel Rojo</strong>
            <p class="text-xs text-gray-600">Peligro inminente - Requiere acción inmediata</p>
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-orange-200 rounded-lg cursor-pointer hover:bg-orange-50 hover:border-orange-400 transition">
          <input type="checkbox" name="nivelesInteres" value="naranja" class="w-5 h-5 text-orange-600">
          <span class="ml-3">
            <span class="text-lg mr-2">🟠</span>
            <strong class="text-orange-700">Nivel Naranja</strong>
            <p class="text-xs text-gray-600">Alto riesgo - Prepararse para actuar</p>
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-yellow-200 rounded-lg cursor-pointer hover:bg-yellow-50 hover:border-yellow-400 transition">
          <input type="checkbox" name="nivelesInteres" value="amarillo" class="w-5 h-5 text-yellow-600">
          <span class="ml-3">
            <span class="text-lg mr-2">🟡</span>
            <strong class="text-yellow-700">Nivel Amarillo</strong>
            <p class="text-xs text-gray-600">Riesgo moderado - Estar alerta</p>
          </span>
        </label>

        <label class="flex items-center p-4 border-2 border-green-200 rounded-lg cursor-pointer hover:bg-green-50 hover:border-green-400 transition">
          <input type="checkbox" name="nivelesInteres" value="verde" class="w-5 h-5 text-green-600">
          <span class="ml-3">
            <span class="text-lg mr-2">🟢</span>
            <strong class="text-green-700">Nivel Verde</strong>
            <p class="text-xs text-gray-600">Bajo riesgo - Información preventiva</p>
          </span>
        </label>
      </div>
    </div>

    <!-- Términos y condiciones -->
    <div class="mb-6">
      <label class="flex items-start">
        <input type="checkbox" required class="mt-1 w-5 h-5 text-blue-600">
        <span class="ml-3 text-sm text-gray-700">
          Acepto recibir notificaciones sobre alertas según mis preferencias y entiendo que puedo desuscribirme en cualquier momento. <span class="text-red-500">*</span>
        </span>
      </label>
    </div>

    <!-- Botones -->
    <div class="flex justify-end gap-4">
      <a href="/alertas" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition font-medium">
        Cancelar
      </a>
      <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
        Suscribirme
      </button>
    </div>
  </form>

  <!-- Información adicional -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-4xl mb-3">🔔</div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">Notificaciones Instantáneas</h3>
      <p class="text-sm text-gray-600">Recibe alertas en tiempo real sobre situaciones de emergencia en tu región</p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-4xl mb-3">🎯</div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">Información Personalizada</h3>
      <p class="text-sm text-gray-600">Solo recibirás notificaciones relevantes según tus preferencias y ubicación</p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-4xl mb-3">🔒</div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">Datos Protegidos</h3>
      <p class="text-sm text-gray-600">Tu información personal está segura y no será compartida con terceros</p>
    </div>
  </div>
</div>
