<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <a href="/alertas" class="text-blue-600 hover:text-blue-700 flex items-center mb-4">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Volver a alertas
    </a>
    <h1 class="text-4xl font-bold text-gray-800 mb-2 flex items-center">
      <svg class="w-10 h-10 mr-3 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
      Medidas de Autocuidado
    </h1>
    <p class="text-gray-600">Aprende cómo protegerte y actuar ante diferentes emergencias</p>
  </div>

  <!-- Selector de tipo de emergencia -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Selecciona el Tipo de Emergencia</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {{#each medidasAutocuidado}}
      <a href="/alertas/autocuidado?tipo={{this.tipoEmergencia}}" class="group">
        <div class="bg-gradient-to-br from-{{this.color}}-400 to-{{this.color}}-500 rounded-lg shadow-lg p-6 text-white hover:shadow-xl transition transform hover:scale-105 cursor-pointer
          {{#if (eq this.tipoEmergencia ../tipoSeleccionado)}}ring-4 ring-{{this.color}}-600 ring-offset-2{{/if}}
        ">
          <div class="text-6xl mb-3 text-center">{{this.icono}}</div>
          <h3 class="text-xl font-bold text-center">{{this.tipoEmergencia}}</h3>
        </div>
      </a>
      {{/each}}
    </div>
  </div>

  <!-- Medidas detalladas -->
  {{#if medidaSeleccionada}}
  <div class="space-y-6">
    <!-- Banner con el tipo seleccionado -->
    <div class="bg-gradient-to-br from-{{medidaSeleccionada.color}}-500 to-{{medidaSeleccionada.color}}-600 rounded-lg shadow-lg p-8 text-white">
      <div class="flex items-center justify-center">
        <div class="text-8xl mr-6">{{medidaSeleccionada.icono}}</div>
        <div>
          <h2 class="text-4xl font-bold mb-2">{{medidaSeleccionada.tipoEmergencia}}</h2>
          <p class="text-{{medidaSeleccionada.color}}-100 text-lg">Medidas de prevención y protección</p>
        </div>
      </div>
    </div>

    <!-- ANTES de la emergencia -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="bg-blue-500 px-6 py-4">
        <h3 class="text-2xl font-bold text-white flex items-center">
          <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
          ANTES de la Emergencia - Preparación
        </h3>
        <p class="text-blue-100 mt-2">Acciones preventivas y de preparación</p>
      </div>
      <div class="p-6">
        <ul class="space-y-3">
          {{#each medidaSeleccionada.medidas.antes}}
          <li class="flex items-start">
            <svg class="w-6 h-6 mr-3 text-blue-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-700 text-lg">{{this}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>

    <!-- DURANTE la emergencia -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="bg-red-500 px-6 py-4">
        <h3 class="text-2xl font-bold text-white flex items-center">
          <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          DURANTE la Emergencia - Acción
        </h3>
        <p class="text-red-100 mt-2">Qué hacer mientras ocurre la emergencia</p>
      </div>
      <div class="p-6">
        <ul class="space-y-3">
          {{#each medidaSeleccionada.medidas.durante}}
          <li class="flex items-start">
            <svg class="w-6 h-6 mr-3 text-red-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-gray-700 text-lg">{{this}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>

    <!-- DESPUÉS de la emergencia -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="bg-green-500 px-6 py-4">
        <h3 class="text-2xl font-bold text-white flex items-center">
          <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          DESPUÉS de la Emergencia - Recuperación
        </h3>
        <p class="text-green-100 mt-2">Acciones posteriores y recuperación</p>
      </div>
      <div class="p-6">
        <ul class="space-y-3">
          {{#each medidaSeleccionada.medidas.despues}}
          <li class="flex items-start">
            <svg class="w-6 h-6 mr-3 text-green-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700 text-lg">{{this}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>

    <!-- Kit de Emergencia -->
    <div class="bg-gradient-to-br from-orange-50 to-orange-100 border-2 border-orange-400 rounded-lg p-8">
      <div class="flex items-start">
        <div class="text-6xl mr-6">🎒</div>
        <div class="flex-1">
          <h3 class="text-2xl font-bold text-orange-800 mb-4">Kit de Emergencia Básico</h3>
          <p class="text-orange-700 mb-4">Todo hogar debe tener preparado un kit de emergencia con los siguientes elementos:</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">💧 Agua:</span> 3 litros por persona por día (mínimo 3 días)
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">🍞 Alimentos:</span> No perecederos para 3 días
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">💊 Botiquín:</span> Medicamentos esenciales y primeros auxilios
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">📄 Documentos:</span> Copias de identificaciones en bolsa impermeable
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">🔦 Linterna:</span> Con baterías adicionales
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">📻 Radio:</span> De pilas o manivela
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">🔋 Cargador:</span> Portátil para celular
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">💰 Efectivo:</span> Billetes pequeños
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">👕 Ropa:</span> Muda adicional y abrigo
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">🧼 Higiene:</span> Artículos de aseo personal
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">🔪 Herramientas:</span> Navaja multiusos, fósforos
            </div>
            <div class="bg-white rounded-lg p-3 shadow">
              <span class="font-semibold text-orange-800">📱 Contactos:</span> Lista impresa de emergencia
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{else}}
  <!-- Mensaje cuando no se ha seleccionado tipo -->
  <div class="bg-white rounded-lg shadow-md p-12 text-center">
    <svg class="w-20 h-20 text-purple-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
    </svg>
    <h3 class="text-2xl font-semibold text-gray-700 mb-4">Selecciona un tipo de emergencia</h3>
    <p class="text-gray-500 mb-6">Elige una de las opciones arriba para ver las medidas de autocuidado específicas</p>
  </div>
  {{/if}}

  <!-- Líneas de emergencia -->
  <div class="bg-red-600 rounded-lg shadow-lg p-8 text-white mt-8">
    <div class="flex items-center mb-6">
      <svg class="w-10 h-10 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
      </svg>
      <h3 class="text-3xl font-bold">Líneas de Emergencia</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white bg-opacity-20 rounded-lg p-4">
        <p class="text-red-100 text-sm mb-1">Emergencias Generales</p>
        <p class="text-4xl font-bold">123</p>
      </div>
      <div class="bg-white bg-opacity-20 rounded-lg p-4">
        <p class="text-red-100 text-sm mb-1">Defensoría del Pueblo</p>
        <p class="text-4xl font-bold">141</p>
      </div>
      <div class="bg-white bg-opacity-20 rounded-lg p-4">
        <p class="text-red-100 text-sm mb-1">Cruz Roja Colombiana</p>
        <p class="text-4xl font-bold">132</p>
      </div>
    </div>
  </div>

  <!-- Recursos adicionales -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <a href="/alertas" class="bg-white rounded-lg shadow-md p-6 hover:shadow-xl transition">
      <div class="text-4xl mb-3">🚨</div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">Ver Alertas Activas</h3>
      <p class="text-sm text-gray-600">Consulta las alertas vigentes en tu región</p>
    </a>

    <a href="/alertas/albergues" class="bg-white rounded-lg shadow-md p-6 hover:shadow-xl transition">
      <div class="text-4xl mb-3">🏠</div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">Albergues Cercanos</h3>
      <p class="text-sm text-gray-600">Encuentra refugios seguros disponibles</p>
    </a>

    <a href="/alertas/suscripcion" class="bg-white rounded-lg shadow-md p-6 hover:shadow-xl transition">
      <div class="text-4xl mb-3">🔔</div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">Suscríbete</h3>
      <p class="text-sm text-gray-600">Recibe notificaciones de alertas</p>
    </a>
  </div>
</div>
