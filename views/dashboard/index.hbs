<!-- Fondo con partículas animadas -->
<div class="fixed inset-0 -z-10 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50"></div>
  <div id="particles-container" class="absolute inset-0"></div>
</div>

<!-- Hero Section del Dashboard -->
<div class="relative overflow-hidden">
  <!-- Formas decorativas con parallax -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-400/20 to-purple-400/20 rounded-full blur-3xl animate-float" data-speed="0.5"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-tr from-pink-400/20 to-orange-400/20 rounded-full blur-3xl animate-float" style="animation-delay: 2s;" data-speed="0.3"></div>

  <div class="container mx-auto px-4 py-12">
    <!-- Header animado -->
    <div class="mb-12 text-center" data-aos="fade-down" data-aos-duration="1000">
      <h1 class="text-5xl md:text-6xl font-black mb-4">
        <span class="bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent animate-gradient">
          Panel de Control
        </span>
      </h1>
      <p class="text-xl text-gray-600">Indicadores estratégicos en tiempo real</p>
      <div class="mt-4 flex justify-center gap-2">
        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
        <span class="text-sm text-gray-500">Sistema activo</span>
      </div>
    </div>

    <!-- Indicadores principales con animación -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">

      <!-- Card 1: Aportes -->
      <div class="group relative" data-aos="fade-up" data-aos-delay="100">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-400 to-blue-600 rounded-3xl blur opacity-25 group-hover:opacity-75 transition duration-500"></div>
        <div class="relative bg-white rounded-3xl shadow-xl p-6 transform hover:scale-105 hover:-rotate-1 transition-all duration-500">
          <div class="flex items-center justify-between mb-4">
            <div class="p-4 rounded-2xl bg-gradient-to-br from-blue-400 to-blue-600 shadow-lg transform group-hover:rotate-12 transition-transform duration-500">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="text-2xl">💰</div>
          </div>
          <p class="text-gray-600 text-sm mb-2 font-medium">Aportes Totales</p>
          <p class="text-4xl font-black bg-gradient-to-r from-blue-600 to-blue-800 bg-clip-text text-transparent mb-2">
            <span class="counter" data-target="{{indicadores.aportesTotales.monto}}">0</span>
          </p>
          <div class="flex items-center gap-2 text-sm">
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full font-semibold">{{indicadores.aportesTotales.crecimiento}}</span>
          </div>
          <p class="text-xs text-gray-500 mt-2">{{indicadores.aportesTotales.cantidad}} contribuciones</p>
        </div>
      </div>

      <!-- Card 2: Personas -->
      <div class="group relative" data-aos="fade-up" data-aos-delay="200">
        <div class="absolute inset-0 bg-gradient-to-r from-green-400 to-emerald-600 rounded-3xl blur opacity-25 group-hover:opacity-75 transition duration-500"></div>
        <div class="relative bg-white rounded-3xl shadow-xl p-6 transform hover:scale-105 hover:rotate-1 transition-all duration-500">
          <div class="flex items-center justify-between mb-4">
            <div class="p-4 rounded-2xl bg-gradient-to-br from-green-400 to-emerald-600 shadow-lg transform group-hover:rotate-12 transition-transform duration-500">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <div class="text-2xl">👥</div>
          </div>
          <p class="text-gray-600 text-sm mb-2 font-medium">Personas Beneficiadas</p>
          <p class="text-4xl font-black bg-gradient-to-r from-green-600 to-emerald-800 bg-clip-text text-transparent mb-2">
            <span class="counter" data-target="{{indicadores.personasBeneficiadas.total}}">0</span>
          </p>
          <p class="text-xs text-gray-500">
            <span class="counter-small" data-target="{{indicadores.personasBeneficiadas.ninos}}">0</span> niños,
            <span class="counter-small" data-target="{{indicadores.personasBeneficiadas.adultos}}">0</span> adultos
          </p>
        </div>
      </div>

      <!-- Card 3: Zonas -->
      <div class="group relative" data-aos="fade-up" data-aos-delay="300">
        <div class="absolute inset-0 bg-gradient-to-r from-purple-400 to-pink-600 rounded-3xl blur opacity-25 group-hover:opacity-75 transition duration-500"></div>
        <div class="relative bg-white rounded-3xl shadow-xl p-6 transform hover:scale-105 hover:-rotate-1 transition-all duration-500">
          <div class="flex items-center justify-between mb-4">
            <div class="p-4 rounded-2xl bg-gradient-to-br from-purple-400 to-pink-600 shadow-lg transform group-hover:rotate-12 transition-transform duration-500">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div class="text-2xl">📍</div>
          </div>
          <p class="text-gray-600 text-sm mb-2 font-medium">Zonas Intervenidas</p>
          <p class="text-4xl font-black bg-gradient-to-r from-purple-600 to-pink-800 bg-clip-text text-transparent mb-2">
            <span class="counter" data-target="{{indicadores.zonasIntervenidas.total}}">0</span>
