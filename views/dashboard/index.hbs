<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Panel de Control</h1>
    <p class="text-gray-600">Indicadores estratégicos en tiempo real</p>
  </div>

  <!-- Indicadores principales -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Total Aportes -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="p-3 rounded-full bg-blue-100">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <div>
        <p class="text-gray-600 text-sm mb-1">Aportes Totales</p>
        <p class="text-3xl font-bold text-gray-900">{{formatCurrency indicadores.aportesTotales.monto}}</p>
        <p class="text-sm text-green-600 mt-1">{{indicadores.aportesTotales.crecimiento}}</p>
        <p class="text-xs text-gray-500 mt-1">{{indicadores.aportesTotales.cantidad}} contribuciones</p>
      </div>
    </div>

    <!-- Personas Beneficiadas -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="p-3 rounded-full bg-green-100">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
      </div>
      <div>
        <p class="text-gray-600 text-sm mb-1">Personas Beneficiadas</p>
        <p class="text-3xl font-bold text-gray-900">{{formatNumber indicadores.personasBeneficiadas.total}}</p>
        <p class="text-xs text-gray-500 mt-1">
          {{formatNumber indicadores.personasBeneficiadas.ninos}} niños,
          {{formatNumber indicadores.personasBeneficiadas.adultos}} adultos
        </p>
      </div>
    </div>

    <!-- Zonas Intervenidas -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="p-3 rounded-full bg-purple-100">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
      </div>
      <div>
        <p class="text-gray-600 text-sm mb-1">Zonas Intervenidas</p>
        <p class="text-3xl font-bold text-gray-900">{{indicadores.zonasIntervenidas.total}}</p>
        <p class="text-xs text-gray-500 mt-1">En 5 departamentos</p>
      </div>
    </div>

    <!-- Voluntarios -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="p-3 rounded-full bg-orange-100">
          <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
      </div>
      <div>
        <p class="text-gray-600 text-sm mb-1">Voluntarios Activos</p>
        <p class="text-3xl font-bold text-gray-900">{{indicadores.voluntarios.total}}</p>
        <p class="text-xs text-gray-500 mt-1">{{formatNumber indicadores.voluntarios.horasDonadas}} horas donadas</p>
      </div>
    </div>
  </div>

  <!-- Alertas Activas -->
  {{#if alertasActivas}}
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Alertas Activas</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {{#each alertasActivas}}
      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-{{#if (eq nivel 'Rojo')}}red-500{{else if (eq nivel 'Naranja')}}orange-500{{else}}yellow-500{{/if}}">
        <div class="flex items-center justify-between mb-3">
          <span class="px-3 py-1 rounded-full text-sm font-semibold {{badgeAlerta nivel}}">
            {{nivel}}
          </span>
          <span class="text-xs text-gray-500">{{tipo}}</span>
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">{{region}}</h3>
        <p class="text-sm text-gray-600 mb-3">{{descripcion}}</p>
        <p class="text-xs text-gray-500">Vigente hasta: {{formatDateShort vigenciaHasta}}</p>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- Distribución de Ayuda -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Tipos de Ayuda -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Distribución por Tipo de Ayuda</h2>
      <div class="space-y-4">
        {{#each (json indicadores.tiposAyuda)}}
        <div>
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-700">{{@key}}</span>
            <span class="font-semibold">{{this}}</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2">
            <div class="bg-blue-600 h-2 rounded-full" style="width: {{this}}%"></div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Zonas por Departamento -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Intervenciones por Departamento</h2>
      <div class="space-y-4">
        {{#each (json indicadores.zonasIntervenidas.porDepartamento)}}
        <div class="flex justify-between items-center">
          <span class="text-gray-700">{{@key}}</span>
          <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-semibold">
            {{this}} zonas
          </span>
        </div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- Zonas Recientes -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-bold text-gray-900">Zonas Afectadas Recientes</h2>
      <a href="/mapa" class="text-blue-600 hover:text-blue-800 text-sm font-semibold">
        Ver todas →
      </a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Zona</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emergencia</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prioridad</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Afectados</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          {{#each zonasRecientes}}
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900">{{nombre}}</div>
              <div class="text-sm text-gray-500">{{municipio}}, {{departamento}}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              {{tipoEmergencia}}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full {{badgePrioridad nivelPrioridad}}">
                {{nivelPrioridad}}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              {{formatNumber poblacionAfectada}} personas
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              {{formatDateShort fechaReporte}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Acciones rápidas -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <a href="/aportes" class="bg-blue-600 hover:bg-blue-700 text-white rounded-lg p-6 text-center transition-colors duration-200">
      <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      <h3 class="text-lg font-semibold mb-2">Hacer un Aporte</h3>
      <p class="text-sm opacity-90">Contribuye con la causa solidaria</p>
    </a>

    <a href="/comunicacion" class="bg-green-600 hover:bg-green-700 text-white rounded-lg p-6 text-center transition-colors duration-200">
      <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
      </svg>
      <h3 class="text-lg font-semibold mb-2">Reportar Necesidad</h3>
      <p class="text-sm opacity-90">Comunica una situación de emergencia</p>
    </a>

    <a href="/mapa" class="bg-purple-600 hover:bg-purple-700 text-white rounded-lg p-6 text-center transition-colors duration-200">
      <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
      </svg>
      <h3 class="text-lg font-semibold mb-2">Ver Mapa</h3>
      <p class="text-sm opacity-90">Explora las zonas afectadas</p>
    </a>
  </div>
</div>
