    <!-- Acciones Rápidas con efecto 3D -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="zoom-in" data-aos-duration="1000">

      <a href="/aportes" class="group relative perspective-1000">
